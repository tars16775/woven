{
  "name": "@woven/site-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The public site's backend: reservations, applications, contact notes and opt-in health pings. Holds no household data.",
  "scripts": {
    "dev": "node --experimental-strip-types src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
