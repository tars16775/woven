{
  "name": "@woven/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Woven Core service: identity, policy, ledger, files, photos, home and Tandem, running inside the house.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "snapshot": "tsx src/cli/snapshot.ts",
    "restore": "tsx src/cli/restore.ts",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx src/cli/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/websocket": "^11.3.0",
    "@peculiar/x509": "^2.1.0",
    "@simplewebauthn/server": "^14.0.1",
    "@woven/hal": "workspace:*",
    "@woven/policy": "workspace:*",
    "@woven/schema": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "pino": "^9.9.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "ulid": "^3.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
