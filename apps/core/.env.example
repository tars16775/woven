# The Woven Core reads configuration from the environment only.
# Secrets never go here; they live in the keys directory or the platform keychain.

# Data root. On the Mac this is the APFS volume.
WOVEN_DATA=/Volumes/Woven/Woven Data

# Where to listen. 0.0.0.0 so devices on the home network can reach it.
WOVEN_HOST=0.0.0.0
WOVEN_PORT=4000

# Browser origins allowed to call the API.
WOVEN_ORIGINS=http://localhost:3000,https://woven.local:3000,http://woven.local:3000

# Advertise on the LAN as _woven._tcp and answer for WOVEN_NAME so the site can find the core.
WOVEN_MDNS=on
WOVEN_NAME=woven.local

# HTTPS with the household certificate authority (ADR 0006). Off only for tests.
# The plain-HTTP trust page that hands devices the CA lives on WOVEN_TRUST_PORT.
WOVEN_TLS=on
WOVEN_TRUST_PORT=4001
# Plain-HTTP copy of the API on 127.0.0.1 only (this machine). 0 turns it off.
WOVEN_LOCAL_PORT=4002

LOG_LEVEL=info

# The Gate (ADR 0005): "spawn" runs it as a child process on this machine, "off" runs without one,
# or give the URL of a Gate running on the Outside processor. Crossings may only reach WOVEN_GATE_ALLOW hosts.
WOVEN_GATE=spawn
WOVEN_GATE_PORT=4010
WOVEN_GATE_ALLOW=api.anthropic.com

