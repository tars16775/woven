#!/bin/bash
# The woven command: start, stop, status, logs, update, uninstall. Installed by install.sh.
set -euo pipefail
WOVEN_HOME="${WOVEN_HOME:-$HOME/.woven}"
LABEL="${WOVEN_LABEL:-com.woven.core}"
# Where install.sh put the service file. With WOVEN_NO_LAUNCHD it writes the
# plist inside WOVEN_HOME and touches nothing outside it, and this command has
# to look in the same place or start, rollback and uninstall quietly miss it.
if [ -n "${WOVEN_NO_LAUNCHD:-}" ] || { [ ! -f "$HOME/Library/LaunchAgents/$LABEL.plist" ] && [ -f "${WOVEN_HOME:-$HOME/.woven}/$LABEL.plist" ]; }; then
  PLIST="${WOVEN_HOME:-$HOME/.woven}/$LABEL.plist"
else
  PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
fi
CONFIG="$WOVEN_HOME/config.env"
APP="$WOVEN_HOME/current"
LOG="$WOVEN_HOME/logs/core.log"

usage() {
  cat <<USAGE
woven <command>

  start        start the Core (and keep it running across logins)
  stop         stop the Core
  restart      stop, then start
  status       is it running, and where
  logs         follow the Core's log
  open         open the dashboard in your browser
  config       show the configuration file (edit with any editor, then: woven restart)
  update       fetch the newest signed release, restart, and roll back on its own if the new Core does not answer
  rollback     go back to the release that ran before the last update
  uninstall    remove the service and the program (your data stays in the data folder)
  version      what is installed
USAGE
}

loaded() { launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; }
setting() { (grep -E "^$1=" "$CONFIG" 2>/dev/null | cut -d= -f2- | tr -d '"') || true; }
port() { setting WOVEN_PORT; }
name() { setting WOVEN_NAME; }
datadir() { setting WOVEN_DATA; }

case "${1:-}" in
  start)
    [ -f "$PLIST" ] || { echo "Not installed. Run install.sh first."; exit 1; }
    loaded || launchctl bootstrap "gui/$(id -u)" "$PLIST"
    launchctl kickstart -k "gui/$(id -u)/$LABEL" 2>/dev/null || true
    echo "Woven is starting. Dashboard: https://${WOVEN_NAME:-$(name)}:${WOVEN_PORT:-$(port)}"
    ;;
  stop)
    loaded && launchctl bootout "gui/$(id -u)/$LABEL" && echo "Stopped." || echo "Not running."
    ;;
  restart)
    "$0" stop >/dev/null 2>&1 || true
    sleep 1
    "$0" start
    ;;
  status)
    if loaded; then
      pid=$(launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | awk '/pid =/{print $3; exit}')
      echo "Running (pid ${pid:-?}) - https://$(name):$(port) - data: $(datadir)"
      curl -sk --max-time 3 "https://localhost:$(port)/v1/health" || echo "  (not answering yet)"
      echo
    else
      echo "Not running. Start with: woven start"
    fi
    ;;
  logs) tail -n 100 -f "$LOG" ;;
  open) open "https://$(name):$(port)/dashboard" ;;
  config) echo "$CONFIG"; echo; cat "$CONFIG" ;;
  version) cat "$APP/VERSION" 2>/dev/null || echo "unknown" ;;
  update)
    before=$(readlink "$WOVEN_HOME/current" 2>/dev/null || true)
    curl -fsSL "${WOVEN_INSTALLER_URL:-https://raw.githubusercontent.com/tars16775/woven/main/packaging/install.sh}" | WOVEN_HOME="$WOVEN_HOME" WOVEN_NO_OPEN=1 bash
    after=$(readlink "$WOVEN_HOME/current" 2>/dev/null || true)
    [ "$before" = "$after" ] && exit 0
    echo "Waiting for the new Core to answer..."
    ok=""
    for i in $(seq 1 60); do curl -sk --max-time 2 -o /dev/null "https://localhost:$(port)/v1/health" && { ok=1; break; }; sleep 1; done
    if [ -z "$ok" ]; then
      echo "The new Core did not answer within a minute; rolling back to the previous release."
      "$0" rollback
      exit 1
    fi
    echo "Updated to $(cat "$APP/VERSION"). The previous release is kept; 'woven rollback' goes back to it."
    ;;
  rollback)
    prev=$(readlink "$WOVEN_HOME/previous" 2>/dev/null || true)
    [ -n "$prev" ] && [ -d "$prev" ] || { echo "There is no previous release to go back to."; exit 1; }
    cur=$(readlink "$WOVEN_HOME/current" 2>/dev/null || true)
    ln -sfn "$prev" "$WOVEN_HOME/current"
    [ -n "$cur" ] && ln -sfn "$cur" "$WOVEN_HOME/previous"
    launchctl kickstart -k "gui/$(id -u)/$LABEL" 2>/dev/null || "$0" start 2>/dev/null || true
    echo "Rolled back to $(cat "$APP/VERSION"). Your data is untouched."
    ;;
  uninstall)
    "$0" stop >/dev/null 2>&1 || true
    rm -f "$PLIST"
    rm -rf "$WOVEN_HOME/current" "$WOVEN_HOME/releases" "$WOVEN_HOME/node"
    echo "Woven is uninstalled. Your data is untouched at: $(datadir)"
    echo "The household data key stays in your login Keychain (service woven); without it the data folder cannot be read."
    ;;
  *) usage; exit 1 ;;
esac
